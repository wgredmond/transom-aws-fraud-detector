<?xml version="1.0"?>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="aws_fraud_order_score">
        <column xsi:type="int" name="aws_fraud_order_score_id" padding="10" identity="true" unsigned="true" nullable="false" comment="AWS Order Score ID"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="Order Id"/>
        <column xsi:type="int" name="insight_score" unsigned="false" nullable="false" comment="Insight Score"/>
        <column xsi:type="varchar" name="outcome" nullable="true" length="100" comment="Outcome"/>
        <column xsi:type="timestamp" name="updated" nullable="false" on_update="true" default="CURRENT_TIMESTAMP" comment="Updated"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="aws_fraud_order_score_id"/>
        </constraint>

        <constraint xsi:type="foreign" referenceId="AWS_FRAUD_ORDER_SCORE_ORDER_ID_SALES_ORDER_ENTITY_ID" table="aws_fraud_order_score" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>

    </table>

</schema>
