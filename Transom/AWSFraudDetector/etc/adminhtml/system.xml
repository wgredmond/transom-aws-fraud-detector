<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="fraud_protection">
            <group id="transom_aws" type="text" sortOrder="05" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Transom - AWS Fraud Protection</label>

                <group id="config" translate="label comment" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Configuration</label>
                    <field id="active" translate="label" sortOrder="10" type="select" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Enabled</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>

                    <field id="api_key" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>API Key</label>
                        <comment><![CDATA[tbd]]></comment>
                    </field>

                    <!--
                    <field id="api_key" translate="label" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Other key</label>
                        <comment><![CDATA[tbd]]></comment>
                    </field>
                    -->

                </group>
            </group>
        </section>
    </system>
</config>


